{
  "name": "sealed-note",
  "version": "1.0.0",
  "description": "Private notes and inline encrypted blocks for Obsidian, with a vault keyring, TOTP second factor and a recovery key.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "test": "node esbuild.config.mjs test && node --test dist-tests/*.test.mjs",
    "lint": "eslint .",
    "deploy": "node scripts/deploy.mjs"
  },
  "keywords": [
    "obsidian",
    "encryption",
    "privacy",
    "notes"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/qrcode": "^1.5.6",
    "esbuild": "^0.20.2",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.6.0",
    "obsidian": "^1.5.7",
    "qrcode": "^1.5.4",
    "tslib": "^2.6.2",
    "typescript": "^5.4.3",
    "typescript-eslint": "^8.74.0"
  },
  "dependencies": {
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.44.2"
  }
}
